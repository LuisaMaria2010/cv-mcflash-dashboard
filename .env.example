# Backend (repo Autocompilazione CV_ON_SITE).
# In locale: "func start" nel repo backend -> http://localhost:7071
# Sulla Function App: https://<nome-app>.azurewebsites.net
BACKEND_URL=http://localhost:7071

# Chiave della Function (header x-functions-key). In locale con "func start" non serve.
FUNCTION_KEY=

# Timeout delle chiamate al backend, in secondi. L'estrazione di un CV lungo
# arriva a un paio di minuti: per quella chiamata il client usa un timeout piu' lungo.
BACKEND_TIMEOUT_SECONDS=30

# Chi usa la dashboard: finisce nelle bozze e, dalla fase 5, nel registro delle operazioni.
# Vuoto = nome utente di Windows.
DASHBOARD_USER=
